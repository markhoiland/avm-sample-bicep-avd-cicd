{
  "$schema": "https://aka.ms/bicep-config",
  "moduleAliases": {
    "br": {
      "public": {
        "registry": "mcr.microsoft.com",
        "modulePath": "bicep"
      }
    }
  },
  "experimentalFeaturesEnabled": {
    "assertions": true
  },
  "analyzers": {
    "core": {
      "enabled": true,
      "verbose": false,
      "rules": {
        "no-unused-params": {
          "level": "warning"
        },
        "no-unused-vars": {
          "level": "warning"
        },
        "prefer-interpolation": {
          "level": "warning"
        },
        "secure-secrets-in-params": {
          "level": "warning"
        },
        "adminusername-should-not-be-literal": {
          "level": "warning"
        },
        "use-stable-resource-identifiers": {
          "level": "warning"
        }
      }
    }
  }
}
